# Kakao Maps JavaScript SDK (browser-visible key)
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=your_kakao_javascript_key

# Naver Mail SMTP (set real values only in .env.local or the hosting provider)
SMTP_HOST=smtp.naver.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_naver_email@naver.com
SMTP_PASS=your_naver_application_password

# Website inquiry recipient
INQUIRY_TO_EMAIL=your_inquiry_recipient@example.com

# Neon Postgres (automatically added when the Vercel integration is connected)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# The app also accepts POSTGRES_URL or a custom-prefix STORAGE_URL.

# Vercel Blob (automatically added when the Blob store is connected)
BLOB_READ_WRITE_TOKEN=vercel_blob_read_write_token

# One-time secret used only to create the first administrator account
# Use a long random value and remove/rotate it after setup is complete.
ADMIN_SETUP_TOKEN=replace_with_a_long_random_secret
